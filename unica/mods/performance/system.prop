wlan.wfd.hdcp=disable
persist.sys.fuse.passthrough.enable=true
ro.incremental.enable=yes
debug.hwui.use_hint_manager=true
persist.device_config.activity_manager_native_boot.use_freezer=false
persist.device_config.runtime_native.use_app_image_startup_cache=true
persist.zygote.app_data_isolation=false
persist.sys.vold_app_data_isolation_enabled=false
persist.sys.isolated_storage=false
debug.hwui.skia_atrace_enabled=false
debug.hwui.renderer=skiagl
debug.renderengine.backend=skiaglthreaded
renderthread.skia.reduceopstasksplitting=true
dalvik.vm.systemuicompilerfilter=speed
persist.device_config.runtime_native_boot.iorap_perfetto_enable=true
ro.telephony.sim_slots.count=2
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1
logcat.live=disable
debug.sf.hw=1
debug.egl.hw=1
persist.device_config.runtime_native.usap_pool_enabled=true
ro.fast.dormancy=1
ro.config.hw_fast_dormancy=1
ro.ril.fast.dormancy.rule=1
ro.semc.enable.fast_dormancy=true
ro.ril.disable.power.collapse=0
ro.config.hw_quickpoweron=true
ro.gfx.angle.supported=true
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.psi_partial_stall_ms=100
ro.lmk.psi_complete_stall_ms=700
ro.lmk.kill_heaviest_task=true
ro.lmk.critical_upgrade=true
ro.lmk.upgrade_pressure=85
ro.lmk.downgrade_pressure=70
ro.lmk.swap_free_low_percentage=20
ro.lmk.thrashing_limit=30
ro.lmk.thrashing_limit_decay=50
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
debug.sf.latch_unsignaled=1
debug.sf.enable_gl_backpressure=1
debug.sf.early_phase_offset_ns=500000
debug.sf.early_app_phase_offset_ns=500000
debug.sf.early_gl_phase_offset_ns=300000
debug.sf.early_gl_app_phase_offset_ns=1500000
